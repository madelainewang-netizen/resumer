# 大模型服务：配置哪家的 key 就自动用哪家（同时配置多家时优先 Kimi → 通义千问 → 智谱 → DeepSeek）
KIMI_API_KEY=            # Kimi（platform.kimi.com 或 platform.kimi.ai 的 key 都可以）
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=     # 通义千问
# ZHIPU_API_KEY=

# 可选
# AI_PROVIDER=moonshot   # 强制指定：deepseek | moonshot(kimi) | qwen | zhipu
# AI_MODEL=kimi-k3       # 覆盖默认模型
# AI_REASONING_EFFORT=low  # 思考型模型的思考强度：low | medium | high
